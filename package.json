{
  "name": "drift-arrows",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/engine.test.ts tests/storage.test.ts",
    "test:e2e": "npm run build && playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && powershell -NoProfile -File tools\\build-android.ps1",
    "android:release": "npm run android:sync && powershell -NoProfile -File tools\\build-android.ps1 -Release",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
